rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // OTP（Functionsのみ書き込み可、クライアントからアクセス不可）
    match /otps/{email} {
      allow read, write: if false;
    }

    // emailUsers（本人のみ読み取り可、書き込みはFunctionsのみ）
    match /emailUsers/{email} {
      allow read: if request.auth != null && request.auth.token.email == email;
      allow write: if false;
    }

    // teams
    match /teams/{teamId} {
      allow read: if request.auth != null;

      // create: 自分がcreatedByかつmemberIdsに含まれること
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.createdBy
                    && request.auth.uid in request.resource.data.memberIds;

      // update:
      //   ① オーナー (createdBy) はすべてのフィールドを変更可
      //   ② メンバーは plan・createdBy 以外を変更可
      //   ③ 非メンバーは joinTeam 用（memberIds・members への自分追加のみ）
      allow update: if request.auth != null && (
        // ① オーナー
        request.auth.uid == resource.data.createdBy

        // ② メンバー（plan と createdBy は変更不可）
        || (request.auth.uid in resource.data.memberIds
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan', 'createdBy']))

        // ③ joinTeam（自分だけを memberIds に追加する場合のみ）
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members'])
            && request.auth.uid in request.resource.data.memberIds
            && !(request.auth.uid in resource.data.memberIds)
            && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1)
      );

      allow delete: if false;

      // サブコレクション: 認証済みユーザーのみ（teamId 自体が秘密として機能する）
      match /matches/{matchId} {
        allow read, write: if request.auth != null;
      }
      match /venues/{venueId} {
        allow read, write: if request.auth != null;
      }
      match /players/{playerId} {
        allow read, write: if request.auth != null;

        match /steps/{stepId} {
          allow read, write: if request.auth != null;
        }
        match /toreisen/{recordId} {
          allow read, write: if request.auth != null;
        }
      }
      match /seasons/{seasonId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
