rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // チームアイコン：認証済みユーザーのみ読み書き可
    match /teamIcons/{teamId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024  // 5MB以下
                   && request.resource.contentType.matches('image/.*');
    }
    // 選手顔写真：認証済みユーザーのみ読み書き可
    match /playerPhotos/{teamId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024  // 5MB以下
                   && request.resource.contentType.matches('image/.*');
    }
    // 所属チームアイコン：認証済みユーザーのみ読み書き可
    match /teamStepIcons/{teamId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024  // 5MB以下
                   && request.resource.contentType.matches('image/.*');
    }
    // 試合の写真：認証済みユーザーのみ読み書き可
    match /matchPhotos/{teamId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024  // 5MB以下
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
